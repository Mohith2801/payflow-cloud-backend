# Local PostgreSQL defaults (docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payflow
DB_USERNAME=payflow
DB_PASSWORD=payflow
PORT=8080

# Optional Amazon Bedrock integration. Keep false for local/free demo.
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=your-enabled-bedrock-model-id
# Configure AWS credentials using an IAM role or AWS profile; never commit keys.
